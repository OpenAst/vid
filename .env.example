# Core
SECRET_KEY=replace-me
ALLOWED_HOSTS=api.your-domain.com,localhost,127.0.0.1
FRONTEND_ORIGINS=https://www.your-domain.com
PRIMARY_FRONTEND_URL=https://www.your-domain.com
API_BASE_URL=https://api.your-domain.com
COOKIE_DOMAIN=.your-domain.com
REALTIME_INTERNAL_SECRET=replace-me

# Live calls / TURN
TURN_SERVER_URLS=stun:turn.your-domain.com:3478,turn:turn.your-domain.com:3478
TURN_SHARED_SECRET=replace-me
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_REALM=turn.your-domain.com
WEB_PUSH_VAPID_PUBLIC_KEY=replace-me
WEB_PUSH_VAPID_PRIVATE_KEY=replace-me
WEB_PUSH_VAPID_SUBJECT=mailto:you@your-domain.com

# Database
DB_NAME=vid
DB_USER=vid
DB_PASSWORD=replace-me

# Auth
SOCIAL_AUTH_ALLOWED_REDIRECT_URIS=https://www.your-domain.com/auth/google
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=replace-me
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=replace-me

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=you@example.com

# Storage
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=replace-me
AWS_S3_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.your-domain.com

# Frontend build/runtime
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_WS_URL=https://realtime.your-domain.com
NEXT_PUBLIC_REALTIME_URL=https://realtime.your-domain.com
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_MEDIA_HOST=media.your-domain.com
NEXT_PUBLIC_MEDIA_URL=https://media.your-domain.com
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=replace-me
